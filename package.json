{
  "name": "xper-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:web\"",
    "dev:client": "npm run dev --prefix apps/client",
    "dev:web": "npm run dev --prefix apps/web",
    "build:client": "npm run build --prefix apps/client",
    "build:web": "npm run next:build --prefix apps/web",
    "build": "npm run build:client && npm run build:web",
    "start": "pnpm --filter @xper/web run start",
    "lint": "pnpm --filter @xper/web run lint",
    "vercel-build": "pnpm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "next": "^16.0.7",
    "supabase": "^2.118.0"
  }
}