{
  "name": "xper-monorepo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm run dev:all",
    "dev:all": "concurrently -n web,client -c blue,green \"pnpm run dev:web\" \"pnpm run dev:client\"",
    "dev:web": "pnpm --filter @xper/web run dev",
    "dev:client": "pnpm --filter @xper/client run dev",
    "build:client": "pnpm --filter @xper/client run build",
    "copy:client": "mkdir -p apps/web/public/client && cp -r apps/client/dist/* apps/web/public/client/",
    "build:web": "pnpm --filter @xper/web run build",
    "build": "pnpm build:client && pnpm copy:client && pnpm build:web",
    "start": "pnpm --filter @xper/web run start",
    "lint": "pnpm --filter @xper/web run lint",
    "vercel-build": "pnpm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "next": "^16.0.7",
    "supabase": "^2.118.0"
  }
}